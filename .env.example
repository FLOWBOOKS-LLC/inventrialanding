# Copy to .env.local (local dev) or set these in your CI/build environment.

# --- Existing app configuration ---
# VITE_CMS_PROXY_TARGET=http://localhost:42845
# VITE_CMS_API_BASE_PATH=/inventria_new
# VITE_CALENDLY_URL=
# VITE_KYC_URL=
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# --- SEO / analytics (optional) ---
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX.
# When set, GA4 loads and a page_view is sent on every route change.
VITE_GA_MEASUREMENT_ID=

# Google Search Console "HTML tag" verification token (the content value only).
# It is injected into every generated page's <head> at build time.
VITE_GOOGLE_SITE_VERIFICATION=
