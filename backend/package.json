{
  "name": "inventria-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "dev:sandbox": "nodemon src/server.js",
    "dev:prod": "node -e \"process.env.REMITA_ENV='production'; require('child_process').spawn('nodemon',['src/server.js'],{stdio:'inherit',env:process.env,shell:true})\"",
    "start": "node src/server.js"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
